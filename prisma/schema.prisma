// ============================================================
// Tayylo — Prisma schema (self-hosted Postgres, e.g. Neon)
//
// Plus User + PasswordResetToken for our own Auth.js-based authentication.
// Field names are camelCase end-to-end to match src/types/index.ts —
// there is no snake_case translation layer anymore.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---- auth ----

model User {
  id           String   @id @default(uuid())
  // Contact address. NOT an identity key for Apple/Google sign-in — those are
  // matched on AuthIdentity (provider + the provider's stable `sub`). May be an
  // Apple private relay address (…@privaterelay.appleid.com).
  email        String   @unique
  // Null for accounts created with Apple/Google that never set a password.
  passwordHash String?
  // Display name. Apple only sends it on the very first authorization.
  name         String?
  // "tailor" (full workspace) | "customer" (browse Explore, view own documents)
  role         String   @default("tailor")
  createdAt    DateTime @default(now())

  // Tayylo staff access to the admin portal (admin.tayylo.com), independent
  // of role: "owner" | "admin" | "moderator". Null for everyone else.
  staffRole       String?
  // Set by an admin: the account can't sign in or use the API until cleared.
  suspendedAt     DateTime?
  suspendedReason String?
  // Last authenticated API request (throttled), and which client made it.
  lastSeenAt      DateTime?
  lastSeenClient  String? // "web" | "app"
  // Product updates and promotions from Tayylo (every email has an unsubscribe link).
  marketingEmails   Boolean @default(true)
  pushNotifications Boolean @default(true)

  business            Business?
  passwordResetTokens PasswordResetToken[]
  identities          AuthIdentity[]
  stylePosts          StylePost[]
  savedPosts          SavedPost[]
  postReports         PostReport[]
  blocking            UserBlock[]  @relation("blocker")
  blockedBy           UserBlock[]  @relation("blocked")
  adminActions        AdminAuditLog[]
  adminLoginCodes     AdminLoginCode[]
  subscription        Subscription?
  pushTokens          PushToken[]

  @@index([createdAt])
  @@index([lastSeenAt])
}

// A third-party sign-in (Apple, Google) linked to a Tayylo user. The same
// row serves the web and the mobile app, so one Apple ID reaches one account
// everywhere.
model AuthIdentity {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       String // "apple" | "google"
  // The provider's stable user id (`sub`). The only thing identities match on.
  providerUserId String
  // Last email the provider reported (informational; can change or be a relay).
  email          String?
  isPrivateEmail Boolean  @default(false)
  // Apple refresh token, AES-256-GCM encrypted (src/lib/token-crypto.ts).
  // Kept only so the grant can be revoked when the account is deleted.
  refreshToken   String?
  // The Apple client id that issued refreshToken (Services ID on web, bundle
  // id on iOS) — revocation must use the same one.
  tokenClientId  String?
  linkedAt       DateTime @default(now())
  lastSignInAt   DateTime @default(now())

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---- business ----

model Business {
  id           String   @id @default(uuid())
  ownerId      String   @unique
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name         String
  country      String   @default("")
  currency     String   @default("NGN")
  unitSystem   String   @default("imperial") // "imperial" | "metric"
  timezone     String   @default("")
  ownerName    String   @default("")
  garmentTypes String[] @default([])
  // Studio logo (small image data URL). Null = documents use the Tayylo mark.
  logoUrl      String?
  // Accounts clients can pay into: [{ id, bankName, accountName, accountNumber, isDefault }]
  bankAccounts Json     @default("[]")
  // Email (and push, if they use the app) the client when an order changes stage.
  notifyClients Boolean @default(true)
  createdAt    DateTime @default(now())

  customers Customer[]
  templates MeasurementTemplate[]
  measurementSets MeasurementSet[]
  orders    Order[]
  media     Media[]
}

// ---- customers ----

model Customer {
  id        String   @id @default(uuid())
  businessId String
  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  fullName  String
  phones    String[] @default([])
  email     String?
  tags      String[] @default([])
  notes     String?
  photoUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  measurementSets MeasurementSet[]
  orders          Order[]

  @@index([businessId])
}

// ---- media (customer/order/fitting photos) ----

model Media {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  ownerType  String // "customer" | "order" | "fitting"
  ownerId    String
  url        String
  caption    String?
  createdAt  DateTime @default(now())

  @@index([businessId])
  @@index([ownerType, ownerId])
}

// ---- measurement templates ----

model MeasurementTemplate {
  id          String    @id @default(uuid())
  businessId  String? // null = global/system template
  business    Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  category    String
  version     Int       @default(1)
  imageUrl    String?
  archivedAt  DateTime?

  fields          TemplateField[]
  measurementSets MeasurementSet[]

  @@index([businessId])
}

model TemplateField {
  id         String               @id @default(uuid())
  templateId String
  template   MeasurementTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  key        String
  label      String
  group      String
  minMm      Int?
  maxMm      Int?
  sortOrder  Int                  @default(0)
  diagramRef String?

  @@index([templateId])
}

// ---- measurement sets ----

model MeasurementSet {
  id            String    @id @default(uuid())
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  templateId    String
  template      MeasurementTemplate @relation(fields: [templateId], references: [id])
  templateName  String
  takenAt       DateTime  @default(now())
  takenBy       String?
  source        String    @default("manual") // "manual" | "import" | "restored"
  supersedesId  String?
  note          String?
  status        String    @default("final") // "draft" | "final"

  values MeasurementValue[]

  @@index([businessId])
  @@index([customerId])
  @@index([templateId])
}

model MeasurementValue {
  id               String         @id @default(uuid())
  measurementSetId String
  measurementSet   MeasurementSet @relation(fields: [measurementSetId], references: [id], onDelete: Cascade)
  fieldKey         String
  labelSnapshot    String
  valueMm          Int
  rawInput         String

  @@index([measurementSetId])
}

// ---- orders ----

model Order {
  id           String   @id @default(uuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerName String
  number       String
  statusName   String   @default("pending")
  dueAt        DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  note         String?
  priceMinor   Int      @default(0)
  currency     String   @default("NGN")
  // Which of the business's bank accounts this order's invoice shows (null = default)
  bankAccountId String?
  // How many times the agreed price was changed after it was first set (capped)
  priceChangeCount Int @default(0)
  // The last stage the client was told about, so they're never told twice.
  clientNotifiedStatus String?

  items    OrderItem[]
  payments Payment[]
  fittings Fitting[]

  @@index([businessId])
  @@index([customerId])
}

model OrderItem {
  id               String  @id @default(uuid())
  orderId          String
  order            Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  garmentType      String
  measurementSetId String?
  styleNotes       String?
  photos           String[] @default([])
  imageUrl         String?

  @@index([orderId])
}

model Payment {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amountMinor Int
  paidAt      DateTime @default(now())
  method      String
  reference   String?

  @@index([orderId])
}

model Fitting {
  id             String   @id @default(uuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  number         Int
  fittedAt       DateTime @default(now())
  notes          String?
  outcome        String // "adjustments_needed" | "approved" | "skipped"
  resultingSetId String?

  adjustments FittingAdjustment[]

  @@index([orderId])
}

model FittingAdjustment {
  id        String  @id @default(uuid())
  fittingId String
  fitting   Fitting @relation(fields: [fittingId], references: [id], onDelete: Cascade)
  fieldKey  String
  label     String
  deltaMm   Int
  rawDelta  String

  @@index([fittingId])
}

// ---- explore (shared style inspiration between tailors) ----

model StylePost {
  id         String   @id @default(uuid())
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorName String // studio name at time of posting
  country    String
  category   String
  caption    String?
  tags       String[] @default([])
  imageUrl   String
  width      Int?
  height     Int?
  createdAt  DateTime @default(now())
  // Set when enough people report the post; hidden from everyone until reviewed.
  hiddenAt   DateTime?

  saves   SavedPost[]
  reports PostReport[]

  @@index([createdAt])
  @@index([country])
  @@index([category])
  @@index([authorId])
}

model SavedPost {
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      StylePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@id([userId, postId])
  @@index([postId])
}

// Someone flagged an Explore post as objectionable. The post disappears for
// the reporter straight away; enough reports hide it for everyone.
model PostReport {
  id         String    @id @default(uuid())
  postId     String
  post       StylePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User      @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String
  details    String?
  createdAt  DateTime  @default(now())

  @@unique([reporterId, postId])
  @@index([postId])
}

// The blocker no longer sees anything the blocked user posts on Explore.
model UserBlock {
  blockerId String
  blocker   User     @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

// ---- admin portal ----

// Platform-wide switches the admin portal controls (maintenance mode,
// sign-ups, Explore posting, announcement, minimum app version). One row
// per key; values are validated by src/lib/app-settings.ts.
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// Every change made from the admin portal, who made it, and to what.
model AdminAuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String
  action     String // e.g. "user.suspend", "post.delete", "settings.update"
  targetType String? // "user" | "post" | "settings"
  targetId   String?
  summary    String
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
}

// One-time sign-in codes for the admin portal, emailed to staff. Only a hash
// of the code is stored; each code expires quickly and allows few attempts.
model AdminLoginCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

// ---- subscriptions ----

// A plan tailors can be on. Edited from the admin portal. Exactly one plan
// is the default (free) plan everyone without a paid subscription gets.
model Plan {
  key                   String   @id // "free", "pro", ...
  name                  String
  tagline               String   @default("")
  // Selling points shown on the upgrade screen.
  features              String[] @default([])
  // Limits. maxClients null = unlimited.
  maxClients            Int?
  customBranding        Boolean  @default(false) // studio logo on invoices and receipts
  explorePosting        Boolean  @default(true)
  isDefault             Boolean  @default(false)
  active                Boolean  @default(true)
  sortOrder             Int      @default(0)
  // RevenueCat entitlement id that grants this plan in the mobile app.
  revenuecatEntitlement String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  prices        PlanPrice[]
  subscriptions Subscription[]
}

model PlanPrice {
  id               String  @id @default(uuid())
  planKey          String
  plan             Plan    @relation(fields: [planKey], references: [key], onDelete: Cascade)
  interval         String // "monthly" | "yearly"
  currency         String
  amountMinor      Int
  // Paystack plan for this price (created on first checkout).
  paystackPlanCode String?
  // A changed price retires the old row (active = false) rather than editing
  // it, so renewals for people who subscribed at the old price still match.
  active           Boolean @default(true)
  createdAt        DateTime @default(now())

  @@index([planKey, interval, currency])
  @@index([paystackPlanCode])
}

// A user's current paid subscription (one per user). No row, or a lapsed
// one, means the default plan. History lives in BillingEvent.
model Subscription {
  id                     String    @id @default(uuid())
  userId                 String    @unique
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planKey                String
  plan                   Plan      @relation(fields: [planKey], references: [key])
  // "active" | "trialing" | "past_due" | "cancelled" (runs to period end) | "expired"
  status                 String
  // "paystack" | "apple" | "google" | "manual"
  provider               String
  interval               String?
  currency               String?
  amountMinor            Int?
  providerSubscriptionId String?
  providerCustomerId     String?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean   @default(false)
  // Why a manual (complimentary) plan was given.
  note                   String?
  startedAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([planKey])
  @@index([status])
}

// Every payment-provider webhook we act on (and payments), for history,
// revenue and idempotency.
model BillingEvent {
  id          String   @id @default(uuid())
  userId      String?
  provider    String
  type        String
  externalId  String
  amountMinor Int?
  currency    String?
  payload     Json
  createdAt   DateTime @default(now())

  @@unique([provider, externalId])
  @@index([userId])
  @@index([createdAt])
}

// ---- marketing ----

// Expo push token for a signed-in device running the mobile app.
model PushToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  platform   String // "ios" | "android"
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
}

// A promotional message sent by email and/or push to a chosen audience.
model Campaign {
  id             String    @id @default(uuid())
  title          String // internal name
  subject        String
  body           String // plain text; blank lines start new paragraphs
  ctaLabel       String?
  ctaUrl         String?
  sendEmail      Boolean   @default(true)
  sendPush       Boolean   @default(false)
  pushTitle      String?
  pushBody       String?
  // { roles: string[], plans: string[], countries: string[], activeWithinDays: number | null }
  audience       Json
  status         String    @default("draft") // "draft" | "sending" | "sent"
  // Sending happens in batches; cursor = last user id processed.
  cursor         String?
  lockedAt       DateTime?
  recipients     Int       @default(0)
  emailsSent     Int       @default(0)
  pushSent       Int       @default(0)
  failures       Int       @default(0)
  createdById    String?
  createdByEmail String
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([createdAt])
}
